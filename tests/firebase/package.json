{
  "name": "enso-firebase-security-tests",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "firebase emulators:exec --config ../../firebase.json --only firestore,storage --project demo-enso-security \"mocha --timeout 15000 \\\"*.rules.test.cjs\\\"\"",
    "test:firestore": "firebase emulators:exec --config ../../firebase.json --only firestore --project demo-enso-security \"mocha --timeout 15000 firestore.rules.test.cjs\"",
    "test:storage": "firebase emulators:exec --config ../../firebase.json --only storage --project demo-enso-security \"mocha --timeout 15000 storage.rules.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0",
    "mocha": "^10.8.2"
  }
}
