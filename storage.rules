rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Private voice recordings: one user's files are never readable by another user.
    // Store the object path in Firestore; avoid creating new bearer download URLs.
    match /voice_journals/{uid}/{fileName} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validAudioUpload() {
        return request.resource != null
          && request.resource.size > 0
          && request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType.matches('audio/.*')
          && fileName.matches('^[0-9]+\\.m4a$');
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && validAudioUpload();
      allow delete: if isOwner();
    }

    // Default deny for every other path, including profile images until an explicit
    // owner-scoped path and upload schema are confirmed.
  }
}
