rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function adminUser() {
      return signedIn() && request.auth.token.admin == true;
    }

    function activeOwner(uid) {
      return owner(uid)
        && (!( 'isDeleted' in get(/databases/$(database)/documents/users/$(uid)).data)
          || get(/databases/$(database)/documents/users/$(uid)).data.isDeleted != true);
    }

    function validOptionalString(data, field, maxLength) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function validUserCreate(uid) {
      let data = request.resource.data;
      return owner(uid)
        && data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'createdAt', 'lastLogin',
          'subscription', 'admin', 'isPartner'
        ])
        && (!('email' in data) || data.email == null || data.email is string)
        && validOptionalString(data, 'displayName', 100)
        && validOptionalString(data, 'photoURL', 2048)
        && data.createdAt is timestamp
        && data.lastLogin is timestamp
        && (!('subscription' in data) || data.subscription == 'free')
        && (!('admin' in data) || data.admin == false)
        && (!('isPartner' in data) || data.isPartner == false);
    }

    function validUserUpdate(uid) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return owner(uid)
        && (!( 'isDeleted' in resource.data) || resource.data.isDeleted != true)
        && changed.hasOnly([
          'displayName', 'photoURL', 'lastLogin', 'updatedAt', 'preferences',
          'themePreference', 'companion', 'room', 'reminderHour',
          'reminderMinute', 'pushNotificationsEnabled', 'emailNotificationsEnabled',
          'theme', 'fontSize', 'hasSeenFtue', 'onboardingCompleted', 'fcmTokens'
        ])
        && validOptionalString(data, 'displayName', 100)
        && validOptionalString(data, 'photoURL', 2048)
        && (!('lastLogin' in data) || data.lastLogin is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('preferences' in data) || (data.preferences is map && data.preferences.size() <= 30))
        && validOptionalString(data, 'themePreference', 40)
        && validOptionalString(data, 'companion', 80)
        && validOptionalString(data, 'room', 80)
        && (!('reminderHour' in data) || (data.reminderHour is int && data.reminderHour >= 0 && data.reminderHour <= 23))
        && (!('reminderMinute' in data) || (data.reminderMinute is int && data.reminderMinute >= 0 && data.reminderMinute <= 59))
        && (!('pushNotificationsEnabled' in data) || data.pushNotificationsEnabled is bool)
        && (!('emailNotificationsEnabled' in data) || data.emailNotificationsEnabled is bool)
        && validOptionalString(data, 'theme', 40)
        && (!('fontSize' in data) || (data.fontSize is number && data.fontSize >= 12 && data.fontSize <= 22))
        && (!('hasSeenFtue' in data) || data.hasSeenFtue is bool)
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool)
        && (!('fcmTokens' in data) || (data.fcmTokens is list && data.fcmTokens.size() <= 10));
    }

    function validJournalEntry(uid, data) {
      return data.keys().hasAll(['uid', 'content', 'createdAt', 'type'])
        && data.keys().hasOnly([
          'uid', 'content', 'createdAt', 'type', 'audioPath',
          'audioUrl', 'durationSeconds', 'mood', 'tags'
        ])
        && data.uid == uid
        && data.content is string
        && data.content.size() <= 20000
        && data.createdAt is timestamp
        && data.type in ['text', 'voice']
        && validOptionalString(data, 'mood', 40)
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('durationSeconds' in data) || (data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 3600))
        && (data.type != 'voice'
          || (('audioPath' in data)
            && data.audioPath is string
            && data.audioPath.matches('voice_journals/' + uid + '/[0-9]+\\.m4a'))
          || (('audioUrl' in data) && data.audioUrl is string && data.audioUrl.size() <= 4096));
    }

    function validMeditationSession(uid, data) {
      return data.keys().hasAll(['uid', 'durationSeconds', 'plannedMinutes', 'completed', 'createdAt'])
        && data.keys().hasOnly(['uid', 'durationSeconds', 'plannedMinutes', 'completed', 'createdAt'])
        && data.uid == uid
        && data.durationSeconds is int
        && data.durationSeconds >= 10
        && data.durationSeconds <= 1800
        && data.plannedMinutes in [3, 5, 10, 15, 20, 30]
        && data.completed is bool
        && data.createdAt is timestamp;
    }

    function validDailyReflection(uid, docId, data) {
      return data.keys().hasAll(['uid', 'date', 'createdAt'])
        && data.keys().hasOnly([
          'uid', 'date', 'createdAt', 'updatedAt', 'question', 'answer',
          'content', 'reflection', 'mood', 'source'
        ])
        && data.uid == uid
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && docId == uid + '_' + data.date
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && validOptionalString(data, 'question', 2000)
        && validOptionalString(data, 'answer', 20000)
        && validOptionalString(data, 'content', 20000)
        && validOptionalString(data, 'reflection', 20000)
        && validOptionalString(data, 'mood', 40)
        && validOptionalString(data, 'source', 80);
    }

    function validRoomProgress(uid, docId, data) {
      return data.keys().hasAll(['uid', 'roomId', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'roomId', 'updatedAt', 'progress', 'completed', 'streak',
          'count', 'totalSessions', 'lastCompletedAt', 'lastSessionAt'
        ])
        && data.uid == uid
        && data.roomId is string
        && data.roomId.size() > 0
        && data.roomId.size() <= 80
        && docId == uid + '_' + data.roomId
        && data.updatedAt is timestamp
        && (!('progress' in data) || (data.progress is number && data.progress >= 0 && data.progress <= 100))
        && (!('completed' in data) || data.completed is bool)
        && (!('streak' in data) || (data.streak is int && data.streak >= 0))
        && (!('count' in data) || (data.count is int && data.count >= 0))
        && (!('totalSessions' in data) || (data.totalSessions is int && data.totalSessions >= 0))
        && (!('lastCompletedAt' in data) || data.lastCompletedAt is timestamp)
        && (!('lastSessionAt' in data) || data.lastSessionAt is timestamp);
    }

    // User profile: clients may create a free profile and edit only presentation/preferences.
    // Entitlements, admin claims, partner status, and server-computed counters are immutable to clients.
    match /users/{uid} {
      allow read: if owner(uid) && (!( 'isDeleted' in resource.data) || resource.data.isDeleted != true);
      allow create: if validUserCreate(uid);
      allow update: if validUserUpdate(uid);
      allow delete: if false;

      match /journey/{docId} {
        allow read: if activeOwner(uid);
        allow write: if false;
      }
      match /journey_milestones/{docId} {
        allow read: if activeOwner(uid);
        allow write: if false;
      }
      match /journey_events/{docId} {
        allow read: if activeOwner(uid);
        allow write: if false;
      }
      match /journey_progress/{docId} {
        allow read: if activeOwner(uid);
        allow write: if false;
      }

      // Legacy/user-private collections are readable by their owner. Writes are server-only
      // until a concrete client schema and write path are verified.
      match /daily_sessions/{docId} {
        allow read: if activeOwner(uid);
        allow write: if false;
      }
      match /journal_entries/{docId} {
        allow read: if activeOwner(uid);
        allow write: if false;
      }
      match /ai_reports/{docId} {
        allow read: if activeOwner(uid);
        allow write: if false;
      }
      match /user_patterns/{docId} {
        allow read: if activeOwner(uid);
        allow write: if false;
      }
      match /fcm_tokens/{docId} {
        allow read: if activeOwner(uid);
        allow write: if false;
      }
    }

    match /journalEntries/{entryId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validJournalEntry(request.auth.uid, request.resource.data);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validJournalEntry(request.auth.uid, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'mood', 'tags']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /meditationSessions/{sessionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validMeditationSession(request.auth.uid, request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /aiInsights/{insightId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /dailyReflections/{docId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validDailyReflection(request.auth.uid, docId, request.resource.data);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validDailyReflection(request.auth.uid, docId, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /roomProgress/{docId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && validRoomProgress(request.auth.uid, docId, request.resource.data);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validRoomProgress(request.auth.uid, docId, request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.roomId == resource.data.roomId;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Subscription state is server-authoritative. Clients can inspect only their own record.
    match /userSubscriptions/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /subscriptions/{eventId} {
      allow read, write: if false;
    }

    // Legacy partner profile read is retained for the current partner screen.
    match /partners/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }

    match /partner_profiles/{uid} {
      allow read: if (owner(uid) || adminUser());
      allow write: if false;

      match /ledger/{entryId} {
        allow read: if owner(uid) || adminUser();
        allow write: if false;
      }
      match /payouts/{payoutId} {
        allow read: if owner(uid) || adminUser();
        allow write: if false;
      }
      match /rewards/{rewardId} {
        allow read: if owner(uid) || adminUser();
        allow write: if false;
      }
      match /academy/{moduleId} {
        allow read: if owner(uid) || adminUser();
        allow write: if false;
      }
    }

    match /partner_applications/{uid} {
      allow read: if owner(uid) || adminUser();
      allow write: if false;
    }
    match /partner_activity/{uid} {
      allow read: if owner(uid) || adminUser();
      allow write: if false;
      match /events/{eventId} {
        allow read: if owner(uid) || adminUser();
        allow write: if false;
      }
    }
    match /partner_campaigns/{campaignId} {
      allow read: if signedIn()
        && (resource.data.partnerId == request.auth.uid || adminUser());
      allow write: if false;
    }
    match /partner_milestones/{milestoneId} {
      allow read: if signedIn()
        && (resource.data.partnerId == request.auth.uid || adminUser());
      allow write: if false;
    }

    // Public app configuration only. App Check must be enforced in Firebase Console/SDK,
    // not simulated by a permissive request.app check in Firestore Rules.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // All other collections (including admin, payment, referral, audit, notification,
    // feature-flag and content collections) are denied to direct client access by default.
  }
}
